{
  "name": "crypt-depths",
  "productName": "Глубины Крипты",
  "version": "0.1.0",
  "description": "Глубины Крипты — desktop test build",
  "main": "main.js",
  "private": true,
  "author": "Slava Bilokur",
  "scripts": {
    "start": "electron .",
    "release": "./release.sh"
  },
  "devDependencies": {
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.svsq.cryptdepths",
    "productName": "Crypt Depths",
    "directories": { "output": "release" },
    "files": ["main.js", "package.json", "game/**/*"],
    "asar": true,
    "artifactName": "crypt-${env.CRYPT_REV}-${os}-${arch}.${ext}",
    "mac": { "target": [{ "target": "dmg", "arch": ["universal"] }], "category": "public.app-category.role-playing-games" },
    "win": { "target": [{ "target": "zip", "arch": ["x64"] }] },
    "linux": { "target": [{ "target": "AppImage", "arch": ["x64"] }], "category": "Game" }
  }
}
